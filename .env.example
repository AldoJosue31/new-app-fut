# Public values. These are embedded in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Server-only values for Route Handlers.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function origins. Use exact origins separated by commas. `*` is only an
# emergency rollback value and should not be used in normal deployments.
EDGE_ALLOWED_ORIGINS=https://futbolapp.vercel.app,https://new-app-fut-aldojosue31s-projects.vercel.app,https://new-app-fut-git-main-aldojosue31s-projects.vercel.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173
# Keep only the exact production and local origins that invoke the remote Edge
# Functions. Do not add port wildcards or arbitrary Vercel preview domains.
# Rollout: shadow -> enforce. Use off only for an emergency rollback.
EDGE_RATE_LIMIT_MODE=shadow

# Legacy rollback aliases are intentionally omitted. During the rollback
# window, Vite/Next config can still read the existing VITE_APP_* variables.
