{
  "name": "new-app-fut",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint app src scripts tests --max-warnings 0",
    "lint:strict": "eslint app src scripts tests --max-warnings 0",
    "lint:fix": "eslint app src scripts tests --fix",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.js",
    "test:edge": "deno test --config deno.json --allow-env --allow-net supabase/functions",
    "test:next-api": "node --conditions=react-server --test tests/next-api/*.test.js",
    "test:contract": "node --test tests/apiContracts.test.js && npm run test:next-api && deno test --config deno.json --allow-env supabase/functions/manage-delegate-account/contract_test.ts",
    "test:e2e": "npm run build && playwright test --project=chromium --project=mobile-chromium --project=webkit",
    "test:e2e:firefox": "npm run build && playwright test --project=firefox",
    "test:baseline:visual": "node scripts/capture-migration-baseline.cjs",
    "verify": "npm run lint && npm run test:unit && npm run test:edge && npm run test:next-api && npm run build",
    "verify:baseline": "npm run verify"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@imgly/background-removal": "^1.7.0",
    "@paddleocr/paddleocr-js": "0.4.2",
    "@supabase/ssr": "0.10.0",
    "@supabase/supabase-js": "2.110.8",
    "client-only": "0.0.1",
    "framer-motion": "^12.34.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "next": "16.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-qr-code": "^2.0.18",
    "server-only": "0.0.1",
    "sileo": "0.1.5",
    "styled-components": "^6.1.19",
    "tailwindcss": "4.1.17",
    "zustand": "^5.0.9"
  },
  "overrides": {
    "@paddleocr/paddleocr-js": {
      "onnxruntime-web": "1.24.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.1.17",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "deno": "2.9.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "supabase": "2.109.1"
  }
}
